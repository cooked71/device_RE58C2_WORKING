# Android fstab file for RE58C2 Recovery
#<src>                                          <mnt_point>         <type>    <mnt_flags>                                                          <fs_mgr_flags>

# System partitions (A/B)
/dev/block/by-name/system       /system           erofs    ro,barrier=1                                 wait,slotselect
/dev/block/by-name/vendor       /vendor           erofs    ro,barrier=1                                 wait,slotselect
/dev/block/by-name/product      /product          erofs    ro,barrier=1                                 wait,slotselect
/dev/block/by-name/system_ext   /system_ext       erofs    ro,barrier=1                                 wait,slotselect
/dev/block/by-name/vendor_dlkm  /vendor_dlkm      erofs    ro,barrier=1                                 wait,slotselect
/dev/block/by-name/odm          /odm              erofs    ro,barrier=1                                 wait,slotselect

# Data and essential partitions
/dev/block/by-name/userdata     /data             f2fs     noatime,nosuid,nodev,discard,fsync_mode=nobarrier    wait,check,formattable,resize
/dev/block/by-name/cache        /cache            ext4     noatime,nosuid,nodev                                wait,check
/dev/block/by-name/metadata     /metadata         ext4     noatime,nosuid,nodev                                wait,formattable
/dev/block/by-name/persist      /persist          ext4     noatime,nosuid,nodev                                wait
/dev/block/by-name/misc         /misc             emmc     defaults                                          defaults

# External SDCard
/dev/block/mmcblk1p1            /sdcard           vfat     defaults                                          wait,voldmanaged=sdcard1:auto
/dev/block/mmcblk1p1            /storage/sdcard1  vfat     defaults                                          wait,voldmanaged=sdcard1:auto
