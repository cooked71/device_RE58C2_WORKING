# Device-specific recovery RC for ${ro.hardware}

# Import common recovery functionality (TWRP-derived)
import /init.recovery.common.rc
# DON'T import init.recovery.usb.rc here - we'll handle it differently

# Create metadata directories for A/B updates
on early-init
    # Ensure /metadata/ota structure exists
    mkdir /metadata/ota 0755 system system
    mkdir /metadata/ota/snapshots 0755 system system
    chmod 0755 /metadata/ota
    chmod 0755 /metadata/ota/snapshots

on post-fs-data
    # Double-check after metadata is mounted
    exec u:r:init:s0 -- /system/bin/sh -c "if [ ! -d /metadata/ota ]; then mkdir -p /metadata/ota/snapshots && chmod 0755 /metadata/ota /metadata/ota/snapshots; fi"

# CRITICAL: Clean USB state before any USB configuration
on property:sys.powerctl=*
    # Clean up USB gadget before reboot to prevent hangs
    write /config/usb_gadget/g1/UDC "none"
    stop adbd
    stop fastbootd
    # Small delay to ensure cleanup completes
    exec -- /system/bin/sleep 0.1

# OVERRIDE the common USB configuration with our own
on property:sys.usb.configfs=1 && property:sys.usb.ffs.ready=1 && property:sys.usb.config=adb
    # Clean up any existing configuration first
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    rm /config/usb_gadget/g1/configs/b.1/f3
    rm /config/usb_gadget/g1/configs/b.1/f4
    rm /config/usb_gadget/g1/configs/b.1/f5
    
    # Set our desired USB IDs (overriding common.rc's 0x1782/0x4d00)
    write /config/usb_gadget/g1/idVendor 0x04E8
    write /config/usb_gadget/g1/idProduct 0x6860
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    
    # Create the ADB function symlink
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    
    # Enable the USB controller
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

# Override MTP+ADB configuration
on property:sys.usb.configfs=1 && property:sys.usb.ffs.ready=1 && property:sys.usb.config=mtp,adb
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    rm /config/usb_gadget/g1/configs/b.1/f3
    rm /config/usb_gadget/g1/configs/b.1/f4
    rm /config/usb_gadget/g1/configs/b.1/f5
    
    write /config/usb_gadget/g1/idVendor 0x04E8
    write /config/usb_gadget/g1/idProduct 0x6860
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

# Override fastboot configuration
on property:sys.usb.configfs=1 && property:sys.usb.ffs.ready=1 && property:sys.usb.config=fastboot
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    rm /config/usb_gadget/g1/configs/b.1/f3
    rm /config/usb_gadget/g1/configs/b.1/f4
    rm /config/usb_gadget/g1/configs/b.1/f5
    
    write /config/usb_gadget/g1/idVendor 0x04E8
    write /config/usb_gadget/g1/idProduct 0x6860
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "fastboot"
    
    symlink /config/usb_gadget/g1/functions/ffs.fastboot /config/usb_gadget/g1/configs/b.1/f1
    
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

# Clean USB state when switching to none
on property:sys.usb.config=none
    write /config/usb_gadget/g1/UDC "none"
    stop adbd
    stop fastbootd
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    rm /config/usb_gadget/g1/configs/b.1/f3
    rm /config/usb_gadget/g1/configs/b.1/f4
    rm /config/usb_gadget/g1/configs/b.1/f5
    setprop sys.usb.state ${sys.usb.config}

# Optional: set device-specific strings (these don't conflict)
on fs
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}

# Start ADB if USB is configured
on property:sys.usb.config=adb
    start adbd

# Start fastboot if USB is configured
on property:sys.usb.config=fastboot
    start fastbootd
