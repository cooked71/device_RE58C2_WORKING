# Device-specific recovery RC for ${ro.hardware}

# Import common recovery functionality (TWRP-derived)
import /init.recovery.common.rc
import /init.recovery.usb.rc

# Create metadata directories for A/B updates
on early-init
    # Ensure /metadata/ota structure exists
    mkdir /metadata/ota 0755 system system
    mkdir /metadata/ota/snapshots 0755 system system
    chmod 0755 /metadata/ota
    chmod 0755 /metadata/ota/snapshots

on post-fs-data
    # Double-check after metadata is mounted
    exec u:r:init:s0 -- /system/bin/sh -c "if [ ! -d /metadata/ota ]; then mkdir -p /metadata/ota/snapshots && chmod 0755 /metadata/ota /metadata/ota/snapshots; fi"


# Device-specific USB IDs
on fs
    # Set vendor/product IDs for ADB and fastboot
    write /config/usb_gadget/g1/idVendor 0x${ro.recovery.usb.vid}
    write /config/usb_gadget/g1/idProduct 0x${ro.recovery.usb.adb.pid}

# Optional: set other device-specific strings
on fs
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}

# Start ADB if USB is configured
on property:sys.usb.config=adb
    start adbd

# Start fastboot if USB is configured
on property:sys.usb.config=fastboot
    start fastbootd

# Stop both if USB is disconnected
on property:sys.usb.config=none
    stop adbd
    stop fastbootd
