// Root symlinks for vendor_ramdisk - located in ramdisk folder
cc_binary {
    name: "vendor_ramdisk_root_symlinks",
    vendor_ramdisk: true,
    
    symlinks: [
        "init:system/bin/init",
        "bin:system/bin", 
        "etc:system/etc",
        "lib:system/lib",
        "lib64:system/lib64",
    ],
}