# Boot Logger Service
# Import this file in your main init.rc with: import /system/etc/init/logger.rc

on early-init
    # Stage 1: Early kernel logging to cache (before data mount)
    start early_kernel_log

on post-fs-data
    # Stage 2: Full logging to /data (after data mount)
    mkdir /data/boot_logs 0711 system system
    start boot_log
    start boot_log_crash  
    start boot_log_kernel
    start continuous_kernel_log
    start log_sync_service

on property:sys.boot_completed=1
    # Stop continuous logging after successful boot
    stop continuous_kernel_log
    stop log_sync_service

# Early kernel logging to cache (available immediately)
service early_kernel_log /system/system/bin/sh /system/system/bin/early_kernel_log.sh
    class core
    user root
    group root system
    oneshot
    seclabel u:r:init:s0

# Main system logs
service boot_log /system/system/bin/logcat -b all -f /data/boot_logs/boot_full.txt -v threadtime -r 16384 -n 10
    class main
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:logcat:s0

# Crash logs
service boot_log_crash /system/system/bin/logcat -b crash -f /data/boot_logs/boot_crash.txt -v threadtime -r 8192 -n 5
    class main
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:logcat:s0

# Kernel logs via logcat
service boot_log_kernel /system/system/bin/logcat -b kernel -f /data/boot_logs/boot_kernel.txt -v threadtime -r 16384 -n 10
    class main
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:logcat:s0

# Continuous kernel message capture
service continuous_kernel_log /system/system/bin/sh /system/system/bin/continuous_kernel_log.sh
    class main
    user root
    group root system
    disabled
    seclabel u:r:shell:s0

# Periodic log sync to prevent data loss
service log_sync_service /system/system/bin/sh /system/system/bin/log_sync.sh
    class main
    user root
    group root system
    disabled
    seclabel u:r:shell:s0