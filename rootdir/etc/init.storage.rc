# MINIMAL STORAGE FIX
on post-fs-data
    # CRITICAL: Set external storage property for MTP
    setprop EXTERNAL_STORAGE /storage/emulated/0
    
    # Create directory structure
    mkdir /storage/emulated 0775 media_rw media_rw
    mkdir /storage/emulated/0 0775 media_rw media_rw
    
    # Bind mount storage (this makes it visible to MTP)
    mount none /storage/emulated/0 bind /data/media/0
    
    # Set permissions for MTP access
    chown media_rw media_rw /storage/emulated/0
    chmod 0775 /storage/emulated/0

on boot
    # Ensure MTP mode is active after boot
    setprop sys.usb.config mtp,adb
    setprop persist.sys.usb.config mtp,adb