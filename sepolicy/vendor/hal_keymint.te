type hal_keymint, domain;
type hal_keymint_exec, exec_type, vendor_file_type, file_type;
type hal_keymint_default_service, service_manager_type;
type hal_keymint_default_hwservice, hwservice_manager_type;

init_daemon_domain(hal_keymint)

binder_use(hal_keymint)
binder_call(hal_keymint, servicemanager)
binder_service(hal_keymint)

allow hal_keymint self:process { execmem execstack };
allow hal_keymint hal_keymint_exec:file { execute execute_no_trans entrypoint read open getattr map };

allow hal_keymint vendor_file:dir { search };
allow hal_keymint vendor_file:file { read open getattr };

# Service permissions
allow hal_keymint hal_keymint_default_service:service_manager find;
allow hal_keymint hal_keymint_default_hwservice:hwservice_manager find;

# Key management permissions
allow hal_keymint keystore_data_file:dir { search };
allow hal_keymint keystore_data_file:file { read open getattr };
