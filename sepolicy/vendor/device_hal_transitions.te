# Manual domain transitions - most compatible approach

# Allow init (any version) to execute HAL binaries
allow init hal_keymint_unisoc_exec:file { getattr open read execute map };
allow init hal_bootctrl_default_exec:file { getattr open read execute map };
allow init hal_gatekeeper_default_exec:file { getattr open read execute map };
allow init hal_codec2_unisoc_exec:file { getattr open read execute map };

# Allow init (any version) to transition to HAL domains
allow init hal_keymint_unisoc:process transition;
allow init hal_bootctrl_default:process transition;
allow init hal_gatekeeper_default:process transition;
allow init hal_codec2_unisoc:process transition;

# Create the actual transitions
type_transition init hal_keymint_unisoc_exec:process hal_keymint_unisoc;
type_transition init hal_bootctrl_default_exec:process hal_bootctrl_default;
type_transition init hal_gatekeeper_default_exec:process hal_gatekeeper_default;
type_transition init hal_codec2_unisoc_exec:process hal_codec2_unisoc;
