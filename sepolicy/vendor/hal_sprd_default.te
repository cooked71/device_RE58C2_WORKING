type hal_sprd_default_exec, exec_type, vendor_file_type, file_type;
type hal_sprd_default, domain;
init_daemon_domain(hal_sprd_default);

# Allow init to execute sprd services
allow init hal_sprd_default_exec:file { execute execute_no_trans };

# Allow binder communication
allow hal_sprd_default init:binder call;
allow init hal_sprd_default:binder transfer;

# Allow hal_sprd_default to communicate with hwservicemanager
allow hal_sprd_default hwservicemanager:binder { call transfer };

# Allow vndbinder access
allow hal_sprd_default vndbinder_device:chr_file { read write open ioctl map };

# Allow service management
allow hal_sprd_default service_manager_type:service_manager find;
