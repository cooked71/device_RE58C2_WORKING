# fastboot.te - SELinux policy for fastbootd
type fastbootd, domain;
type fastbootd_exec, exec_type, file_type;

# Domain transition from init
init_daemon_domain(fastbootd)

# Allow fastbootd basic operations
allow fastbootd self:process { signal getsched setsched getsession getpgid setpgid getcap setcap share getattr noatsecure siginh rlimitinh dyntransition setkeycreate setsockcreate getrlimit };
allow fastbootd self:capability { chown dac_override dac_read_search fowner fsetid setgid setuid setpcap linux_immutable net_bind_service net_broadcast net_admin net_raw ipc_lock ipc_owner sys_module sys_rawio sys_chroot sys_ptrace sys_pacct sys_admin sys_boot sys_nice sys_resource sys_time sys_tty_config mknod lease audit_write audit_control setfcap };
allow fastbootd self:fd use;
allow fastbootd self:fifo_file rw_file_perms;
allow fastbootd self:unix_stream_socket { connectto create_socket_perms };

# Block device access for partition flashing
allow fastbootd block_device:blk_file { getattr read write open ioctl append lock };
allow fastbootd block_device:dir search;

# Access to partition tables and device info
allow fastbootd system_file:file { getattr open read };
allow fastbootd system_prop:property_service set;

# USB/configfs access for USB fastboot mode
allow fastbootd configfs_gadget:dir { search write add_name remove_name };
allow fastbootd configfs_gadget:file { create write unlink setattr getattr open };
allow fastbootd configfs_gadget:lnk_file { create setattr getattr };

# Sysfs access for USB controller
allow fastbootd sysfs_usb_device:file write;

# Access to temporary files
allow fastbootd tmpfs:file { create read write getattr setattr unlink };
allow fastbootd tmpfs:dir { search add_name remove_name write };

# Logging
allow fastbootd logd_socket:sock_file write;
allow fastbootd logd:unix_stream_socket connectto;

# Required for partition operations
allow fastbootd platform_app_data_file:dir search;
allow fastbootd system_data_file:dir search;

# Additional permissions found from your denials
allow fastbootd block_device:blk_file { getattr write };
