type hal_bootctl, domain;
type hal_bootctl_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_bootctl)

binder_use(hal_bootctl)
binder_call(hal_bootctl, servicemanager)
binder_service(hal_bootctl)

allow hal_bootctl self:process { execmem execstack };
allow hal_bootctl hal_bootctl_exec:file { execute execute_no_trans entrypoint read open getattr map };

allow hal_bootctl vendor_file:dir { search };
allow hal_bootctl vendor_file:file { read open getattr };
