



# Broadcast Radio HAL
type hal_broadcastradio_sprd_exec, exec_type, vendor_file_type, file_type;
type hal_broadcastradio_sprd, domain;
init_daemon_domain(hal_broadcastradio_sprd)

# Face Biometrics HAL
type hal_face_sprd_exec, exec_type, vendor_file_type, file_type;
type hal_face_sprd, domain;
init_daemon_domain(hal_face_sprd)

# Engineer service
type hal_engineer_sprd_exec, exec_type, vendor_file_type, file_type;
type hal_engineer_sprd, domain;
init_daemon_domain(hal_engineer_sprd)

# urild service
type urild_sprd_exec, exec_type, vendor_file_type, file_type;
type urild_sprd, domain;
init_daemon_domain(urild_sprd)

# Basic permissions for new domains
allow { hal_broadcastradio_sprd hal_face_sprd hal_engineer_sprd urild_sprd } self:process execmem;
allow { hal_broadcastradio_sprd hal_face_sprd hal_engineer_sprd urild_sprd } vendor_file:file { read getattr open };
allow { hal_broadcastradio_sprd hal_face_sprd hal_engineer_sprd urild_sprd } system_file:file { read getattr open };
allow { hal_broadcastradio_sprd hal_face_sprd hal_engineer_sprd urild_sprd } servicemanager:binder { call transfer };
allow { hal_broadcastradio_sprd hal_face_sprd hal_engineer_sprd urild_sprd } hwservicemanager:binder { call transfer };

# Mali GPU access for SurfaceFlinger
allow surfaceflinger device:chr_file { read write open getattr ioctl map };
allow surfaceflinger gpu_device:chr_file { read write open getattr ioctl map };

# Graphics HAL permissions
allow hal_graphics_sprd device:chr_file { read write open getattr ioctl map };
allow hal_graphics_sprd gpu_device:chr_file { read write open getattr ioctl map };
