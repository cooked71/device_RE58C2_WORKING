# Use Android's existing domains for common services
/vendor/bin/hw/android\.hardware\.audio\.service                                 u:object_r:audioserver_exec:s0
/vendor/bin/hw/android\.hardware\.bluetooth@1\.1-service\.unisoc                  u:object_r:bluetooth_exec:s0

# Use our custom domains for vendor-specific services
/vendor/bin/tee_rpc                                                              u:object_r:hal_tee_exec:s0
/vendor/bin/hw/android\.hardware\.security\.keymint@2\.0-unisoc\.service\.trusty u:object_r:hal_keymint_exec:s0
/vendor/bin/hw/vendor\.sprd\.hardware\.trusty-service                            u:object_r:hal_trusty_exec:s0
/vendor/bin/hw/vendor\.sprd\.hardware\.boot@1\.2-service                          u:object_r:hal_bootctl_exec:s0

# Services that were failing in boot log
/vendor/bin/thermald                                                             u:object_r:hal_thermald_exec:s0
/vendor/bin/hw/vendor\.sprd\.hardware\.thermal@2\.0-service                       u:object_r:hal_thermald_exec:s0
/vendor/bin/hw/vendor\.unisoc\.hardware\.power-service                           u:object_r:hal_power_exec:s0

# Use hal_default for other Sprd services
/vendor/bin/hw/vendor\.sprd\.hardware\.connmgr@1\.0-service                       u:object_r:hal_default_exec:s0
/vendor/bin/hw/vendor\.sprd\.hardware\.wcn@1\.0-service                           u:object_r:hal_default_exec:s0
/vendor/bin/hw/unisoc\.rild                                                      u:object_r:hal_ril_exec:s0

# Generic for other Sprd services
/vendor/bin/hw/vendor\.sprd\.hardware\.*                                          u:object_r:hal_default_exec:s0
