recovery_only(`
userdebug_or_eng(`
permissive fastbootd;
')
')

# MINIMAL HAL domain transitions - only truly unique device-specific types

# KeyMint HAL (Unisoc specific) - this should be unique
type hal_keymint_unisoc_exec, exec_type, vendor_file_type, file_type;
type hal_keymint_unisoc, domain;
init_daemon_domain(hal_keymint_unisoc)

# Boot Control HAL (SPRD specific) - this should be unique  
type hal_bootctrl_sprd_exec, exec_type, vendor_file_type, file_type;
type hal_bootctrl_sprd, domain;
init_daemon_domain(hal_bootctrl_sprd)

# GNSS HAL
type hal_gnss_sprd_exec, exec_type, vendor_file_type, file_type;
type hal_gnss_sprd, domain;
init_daemon_domain(hal_gnss_sprd)

# Bluetooth HAL
type hal_bluetooth_sprd_exec, exec_type, vendor_file_type, file_type;
type hal_bluetooth_sprd, domain;
init_daemon_domain(hal_bluetooth_sprd)

# Camera HAL
type hal_camera_sprd_exec, exec_type, vendor_file_type, file_type;
type hal_camera_sprd, domain;
init_daemon_domain(hal_camera_sprd)

# Thermal HAL
type hal_thermal_sprd_exec, exec_type, vendor_file_type, file_type;
type hal_thermal_sprd, domain;
init_daemon_domain(hal_thermal_sprd)

# Face Biometrics HAL
type hal_face_sprd_exec, exec_type, vendor_file_type, file_type;
type hal_face_sprd, domain;
init_daemon_domain(hal_face_sprd)

# Broadcast Radio HAL
type hal_broadcastradio_sprd_exec, exec_type, vendor_file_type, file_type;
type hal_broadcastradio_sprd, domain;
init_daemon_domain(hal_broadcastradio_sprd)

# Audio HAL
type hal_audio_sprd_exec, exec_type, vendor_file_type, file_type;
type hal_audio_sprd, domain;
init_daemon_domain(hal_audio_sprd)

# Graphics Composer HAL
type hal_graphics_sprd_exec, exec_type, vendor_file_type, file_type;
type hal_graphics_sprd, domain;
init_daemon_domain(hal_graphics_sprd)


# MINIMAL permissions for our HAL services

# Basic file access
allow { hal_keymint_unisoc hal_bootctrl_sprd hal_gnss_sprd hal_bluetooth_sprd hal_camera_sprd hal_thermal_sprd hal_face_sprd hal_broadcastradio_sprd hal_audio_sprd hal_graphics_sprd } vendor_file:file { read getattr open };
allow { hal_keymint_unisoc hal_bootctrl_sprd hal_gnss_sprd hal_bluetooth_sprd hal_camera_sprd hal_thermal_sprd hal_face_sprd hal_broadcastradio_sprd hal_audio_sprd hal_graphics_sprd } system_file:file { read getattr open };

# Binder communication
allow { hal_keymint_unisoc hal_bootctrl_sprd hal_gnss_sprd hal_bluetooth_sprd hal_camera_sprd hal_thermal_sprd hal_face_sprd hal_broadcastradio_sprd hal_audio_sprd hal_graphics_sprd } servicemanager:binder { call transfer };
allow { hal_keymint_unisoc hal_bootctrl_sprd hal_gnss_sprd hal_bluetooth_sprd hal_camera_sprd hal_thermal_sprd hal_face_sprd hal_broadcastradio_sprd hal_audio_sprd hal_graphics_sprd } hwservicemanager:binder { call transfer };

# Specific permissions
allow hal_keymint_unisoc tee_device:chr_file { read write open };
allow hal_bootctrl_sprd system_prop:property_service set;

# Boot control hwservice access

# Additional boot control permissions
allow hal_bootctrl_sprd sysfs:file { read open getattr };
allow hal_bootctrl_sprd block_device:blk_file { read write open getattr };
allow hal_bootctrl_sprd system_prop:property_service { set };

# KeyMint missing permissions (from boot log denials)
allow hal_keymint_unisoc device:chr_file { read write open ioctl };
allow hal_keymint_unisoc vendor_security_patch_level_prop:file { read open getattr map };

# Allow keystore to call KeyMint binder (from boot log denial)
allow keystore hal_keymint_unisoc:binder { call };

# Basic permissions for all new domains
allow { hal_gnss_sprd hal_bluetooth_sprd hal_camera_sprd hal_thermal_sprd hal_face_sprd hal_broadcastradio_sprd hal_audio_sprd hal_graphics_sprd } self:process execmem;
