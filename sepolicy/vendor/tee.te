# TEE (Trusted Execution Environment) domain
type tee, domain;
type tee_exec, exec_type, vendor_file_type, file_type;

# Basic init for tee daemon
init_daemon_domain(tee)

# Allow tee to run as core service  
typeattribute tee coredomain;

# Minimal permissions to get tee_rpc running
allow tee self:process { execmem };
allow tee self:fifo_file rw_file_perms;
allow tee system_prop:property_service set;
allow tee servicemanager:service_manager find;
allow tee vendor_file:file { read open getattr };
allow tee binder:dir { search };
allow tee devlog:sock_file write;