type hal_power, domain;
type hal_power_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_power)

binder_use(hal_power)
binder_call(hal_power, servicemanager)
binder_service(hal_power)

allow hal_power self:process { execmem execstack };
allow hal_power hal_power_exec:file { execute execute_no_trans entrypoint read open getattr map };

allow hal_power vendor_file:dir { search };
allow hal_power vendor_file:file { read open getattr };
