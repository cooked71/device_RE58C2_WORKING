type tee_rpc_exec, exec_type, vendor_file_type, file_type;
type tee_rpc, domain;
init_daemon_domain(tee_rpc);

# Allow init to execute tee_rpc
allow init tee_rpc_exec:file { execute execute_no_trans };

# Allow entrypoint access
allow init tee_rpc:file entrypoint;

# TEE permissions
allow tee_rpc tee_device:chr_file { read write open ioctl };
