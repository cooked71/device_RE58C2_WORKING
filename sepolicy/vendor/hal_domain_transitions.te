# Domain transitions for HAL services

# Allow init to execute HAL binaries
allow init hal_bootctrl_default_exec:file { execute execute_no_trans };
allow init hal_keymint_unisoc_exec2:file { execute execute_no_trans };

# Domain transition from init to HAL domains
type_transition init hal_bootctrl_default_exec:process hal_bootctrl_default;
type_transition init hal_keymint_unisoc_exec2:process hal_keymint_unisoc;

# Additional permissions needed for domain transition
allow init hal_bootctrl_default:process transition;
allow init hal_keymint_unisoc:process transition;

allow hal_bootctrl_default init:process sigchld;
allow hal_keymint_unisoc init:process sigchld;

allow hal_bootctrl_default self:process execmem;
allow hal_keymint_unisoc self:process execmem;

allow hal_bootctrl_default init:fifo_file write;
allow hal_keymint_unisoc init:fifo_file write;

# Additional HAL services
allow init hal_gatekeeper_default_exec:file { execute execute_no_trans };
type_transition init hal_gatekeeper_default_exec:process hal_gatekeeper_default;
allow init hal_gatekeeper_default:process transition;
allow hal_gatekeeper_default init:process sigchld;

allow init hal_codec2_unisoc_exec:file { execute execute_no_trans };
type_transition init hal_codec2_unisoc_exec:process hal_codec2_unisoc;
allow init hal_codec2_unisoc:process transition;
allow hal_codec2_unisoc init:process sigchld;
