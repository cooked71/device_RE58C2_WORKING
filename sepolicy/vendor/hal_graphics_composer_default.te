type hal_graphics_composer_default, domain;
type hal_graphics_composer_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_graphics_composer_default);

# Graphics permissions
allow hal_graphics_composer_default init:binder call;
allow init hal_graphics_composer_default:binder transfer;
allow hal_graphics_composer_default vndbinder_device:chr_file { read write open ioctl map };

# Graphics service permissions
allow hal_graphics_composer_default hwservicemanager:binder { call transfer };
allow hal_graphics_composer_default surfaceflinger_service:service_manager find;
