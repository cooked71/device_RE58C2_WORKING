# KeyMint Trusty service
type vendor_keymint_service, domain;

allow vendor_keymint_service self:process { execmem };
allow vendor_keymint_service vendor_file:file { read execute open getattr map };
allow vendor_keymint_service system_file:file { read open getattr };

# Trusty device access
allow vendor_keymint_service tee_device:chr_file { read write open ioctl };
allow vendor_keymint_service trusty_device:chr_file { read write open ioctl };

# Binder access
allow vendor_keymint_service hwservicemanager:binder { call transfer };
allow vendor_keymint_service hal_keymaster_default:binder { call };

# Key storage
allow vendor_keymint_service keystore_data_file:dir { search };
allow vendor_keymint_service keystore_data_file:file { read write open create };
