# MINIMAL permissions for our HAL services

# Basic file access
allow { hal_keymint_unisoc hal_bootctrl_sprd } vendor_file:file { read getattr open };
allow { hal_keymint_unisoc hal_bootctrl_sprd } system_file:file { read getattr open };

# Binder communication
allow { hal_keymint_unisoc hal_bootctrl_sprd } servicemanager:binder { call transfer };
allow { hal_keymint_unisoc hal_bootctrl_sprd } hwservicemanager:binder { call transfer };

# Specific permissions
allow hal_keymint_unisoc tee_device:chr_file { read write open };
allow hal_bootctrl_sprd system_prop:property_service set;

# Boot control hwservice access

# Additional boot control permissions
allow hal_bootctrl_sprd sysfs:file { read open getattr };
allow hal_bootctrl_sprd block_device:blk_file { read write open getattr };
allow hal_bootctrl_sprd system_prop:property_service { set };

# KeyMint missing permissions (from boot log denials)
allow hal_keymint_unisoc device:chr_file { read write open ioctl };
allow hal_keymint_unisoc vendor_security_patch_level_prop:file { read open getattr map };

# Allow keystore to call KeyMint binder (from boot log denial)
allow keystore hal_keymint_unisoc:binder { call };

# Basic permissions for WiFi HAL - ADDED FOR WIFI FIX
allow hal_wifi_sprd self:process execmem;
allow hal_wifi_sprd vendor_file:file { read getattr open };
allow hal_wifi_sprd system_file:file { read getattr open };
allow hal_wifi_sprd servicemanager:binder { call transfer };
allow hal_wifi_sprd hwservicemanager:binder { call transfer };

# WiFi-specific permissions
allow hal_wifi_sprd wlan_device:chr_file { read write open ioctl };
allow hal_wifi_sprd sysfs_wlan:dir search;
allow hal_wifi_sprd sysfs_wlan:file { read write open getattr };
allow hal_wifi_sprd netlink_kobject_uevent_socket:socket { create connect bind read write };
allow hal_wifi_sprd netlink_route_socket:socket { create connect bind read write };

# Basic permissions for new domains
allow { hal_gnss_sprd hal_bluetooth_sprd hal_camera_sprd hal_thermal_sprd } self:process execmem;
allow { hal_gnss_sprd hal_bluetooth_sprd hal_camera_sprd hal_thermal_sprd } vendor_file:file { read getattr open };
allow { hal_gnss_sprd hal_bluetooth_sprd hal_camera_sprd hal_thermal_sprd } system_file:file { read getattr open };
allow { hal_gnss_sprd hal_bluetooth_sprd hal_camera_sprd hal_thermal_sprd } servicemanager:binder { call transfer };
allow { hal_gnss_sprd hal_bluetooth_sprd hal_camera_sprd hal_thermal_sprd } hwservicemanager:binder { call transfer };

# Basic permissions for new domains
allow { hal_broadcastradio_sprd hal_face_sprd hal_engineer_sprd urild_sprd } self:process execmem;
allow { hal_broadcastradio_sprd hal_face_sprd hal_engineer_sprd urild_sprd } vendor_file:file { read getattr open };
allow { hal_broadcastradio_sprd hal_face_sprd hal_engineer_sprd urild_sprd } system_file:file { read getattr open };
allow { hal_broadcastradio_sprd hal_face_sprd hal_engineer_sprd urild_sprd } servicemanager:binder { call transfer };
allow { hal_broadcastradio_sprd hal_face_sprd hal_engineer_sprd urild_sprd } hwservicemanager:binder { call transfer };

allow hal_graphics_sprd gpu_device:chr_file { read write open getattr ioctl map };

# Graphics HAL
allow hal_graphics_sprd gpu_device:chr_file { read write open getattr ioctl map };

# Basic permissions for graphics HAL
allow hal_graphics_sprd self:process execmem;
allow hal_graphics_sprd vendor_file:file { read getattr open };
allow hal_graphics_sprd system_file:file { read getattr open };
