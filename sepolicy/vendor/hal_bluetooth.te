type hal_bluetooth, domain;
type hal_bluetooth_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_bluetooth)

binder_use(hal_bluetooth)
binder_call(hal_bluetooth, servicemanager)
binder_service(hal_bluetooth)

allow hal_bluetooth self:process { execmem execstack };
allow hal_bluetooth hal_bluetooth_exec:file { execute execute_no_trans entrypoint read open getattr map };

# Bluetooth permissions
allow hal_bluetooth bluetooth_device:chr_file rw_file_perms;
allow hal_bluetooth sysfs_bluetooth_writable:file w_file_perms;

allow hal_bluetooth vendor_file:dir { search };
allow hal_bluetooth vendor_file:file { read open getattr };
