type hal_tee, domain;
type hal_tee_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_tee)

binder_use(hal_tee)
binder_call(hal_tee, servicemanager)
binder_service(hal_tee)

allow hal_tee self:process { execmem execstack };
allow hal_tee hal_tee_exec:file { execute execute_no_trans entrypoint read open getattr map };

allow hal_tee vendor_file:dir { search };
allow hal_tee vendor_file:file { read open getattr };
