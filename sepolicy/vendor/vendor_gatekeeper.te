# Gatekeeper Trusty service
type vendor_gatekeeper_service, domain;

allow vendor_gatekeeper_service self:process { execmem };
allow vendor_gatekeeper_service vendor_file:file { read execute open getattr map };
allow vendor_gatekeeper_service system_file:file { read open getattr };

# Trusty device access
allow vendor_gatekeeper_service tee_device:chr_file { read write open ioctl };
allow vendor_gatekeeper_service trusty_device:chr_file { read write open ioctl };

# Binder access
allow vendor_gatekeeper_service hwservicemanager:binder { call transfer };
allow vendor_gatekeeper_service hal_gatekeeper_default:binder { call };

# Gatekeeper data
allow vendor_gatekeeper_service gatekeeper_data_file:dir { search };
allow vendor_gatekeeper_service gatekeeper_data_file:file { read write open create };
