# Basic permissions for all new domains
allow {
    hal_drm_widevine hal_gatekeeper_sprd hal_media_c2_sprd
    hal_cplog_sprd hal_enhance_sprd hal_hdcp_sprd hal_lights_sprd
    hal_memtrack_sprd hal_network_sprd hal_trusty_sprd hal_oemlock_sprd
    hal_power_sprd hal_log_sprd hal_commondcs_sprd hal_network_v1_sprd
    hal_performance_sprd hal_vibrator_sprd
    dcxsrv_sprd engpc_sprd gpsd_sprd tsupplicant_sprd charged_sprd
    uniber_sprd phasecheckserver_sprd refnotify_sprd slogmodem_sprd
    srtd_sprd thermald_sprd systemdebuggerd_sprd cp_diskserver_sprd
} self:process execmem;

allow {
    hal_drm_widevine hal_gatekeeper_sprd hal_media_c2_sprd
    hal_cplog_sprd hal_enhance_sprd hal_hdcp_sprd hal_lights_sprd
    hal_memtrack_sprd hal_network_sprd hal_trusty_sprd hal_oemlock_sprd
    hal_power_sprd hal_log_sprd hal_commondcs_sprd hal_network_v1_sprd
    hal_performance_sprd hal_vibrator_sprd
    dcxsrv_sprd engpc_sprd gpsd_sprd tsupplicant_sprd charged_sprd
    uniber_sprd phasecheckserver_sprd refnotify_sprd slogmodem_sprd
    srtd_sprd thermald_sprd systemdebuggerd_sprd cp_diskserver_sprd
} vendor_file:file { read getattr open execute };

allow {
    hal_drm_widevine hal_gatekeeper_sprd hal_media_c2_sprd
    hal_cplog_sprd hal_enhance_sprd hal_hdcp_sprd hal_lights_sprd
    hal_memtrack_sprd hal_network_sprd hal_trusty_sprd hal_oemlock_sprd
    hal_power_sprd hal_log_sprd hal_commondcs_sprd hal_network_v1_sprd
    hal_performance_sprd hal_vibrator_sprd
    dcxsrv_sprd engpc_sprd gpsd_sprd tsupplicant_sprd charged_sprd
    uniber_sprd phasecheckserver_sprd refnotify_sprd slogmodem_sprd
    srtd_sprd thermald_sprd systemdebuggerd_sprd cp_diskserver_sprd
} system_file:file { read getattr open };

# Binder communication
allow {
    hal_drm_widevine hal_gatekeeper_sprd hal_media_c2_sprd
    hal_cplog_sprd hal_enhance_sprd hal_hdcp_sprd hal_lights_sprd
    hal_memtrack_sprd hal_network_sprd hal_trusty_sprd hal_oemlock_sprd
    hal_power_sprd hal_log_sprd hal_commondcs_sprd hal_network_v1_sprd
    hal_performance_sprd hal_vibrator_sprd
} servicemanager:binder { call transfer };

allow {
    hal_drm_widevine hal_gatekeeper_sprd hal_media_c2_sprd
    hal_cplog_sprd hal_enhance_sprd hal_hdcp_sprd hal_lights_sprd
    hal_memtrack_sprd hal_network_sprd hal_trusty_sprd hal_oemlock_sprd
    hal_power_sprd hal_log_sprd hal_commondcs_sprd hal_network_v1_sprd
    hal_performance_sprd hal_vibrator_sprd
} hwservicemanager:binder { call transfer };
