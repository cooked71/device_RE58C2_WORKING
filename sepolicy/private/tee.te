# TEE domain
type tee, domain;
type tee_exec, exec_type, system_file_type, vendor_file_type;
type tee_service, service_manager_type;
type tee_hwservice, hwservice_manager_type;
type tee_prop, property_type;

# Domain transition from init
init_daemon_domain(tee)

# Allow tee to use its own executable
allow tee tee_exec:file { entrypoint execute read map getattr open };

# Basic permissions for TEE operation
allow tee self:process { fork sigchld };
allow tee self:capability { sys_admin sys_ptrace };
allow tee ashmem_device:chr_file { read write open map };
allow tee binder_device:chr_file { read write ioctl open };

# Allow TEE to communicate with kernel Trusty drivers
allow tee trusty_device:chr_file { read write ioctl open };
allow tee trusty_log_device:chr_file { read write ioctl open };

# Allow TEE to access vendor files
allow tee vendor_file:dir { search };
allow tee vendor_file:file { read open getattr };

# Allow service registration
allow tee tee_service:service_manager add;
allow tee tee_hwservice:hwservice_manager { add find };

# Property access
allow tee tee_prop:property_service set;