# Generic vendor HAL domain - minimal permissions
type vendor_hal_default, domain;
type vendor_hal_default_exec, vendor_file_type;

init_daemon_domain(vendor_hal_default)

# Basic permissions only
allow vendor_hal_default self:process { sigchld };
allow vendor_hal_default ashmem_device:chr_file { read write map };
allow vendor_hal_default binder_device:chr_file { read ioctl };

# Property types (for property_contexts)
type vendor_tee_prop, property_type;
type vendor_keymint_prop, property_type;
