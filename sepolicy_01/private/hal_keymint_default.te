# KeyMint HAL domain
type hal_keymint_default, domain;
type hal_keymint_default_exec, exec_type, system_file_type, vendor_file_type;
type hal_keymint_default_service, service_manager_type;
type hal_keymint_default_hwservice, hwservice_manager_type;
type hal_keymint_default_prop, property_type;

init_daemon_domain(hal_keymint_default)

# KeyMint needs to communicate with TEE
allow hal_keymint_default tee:fd use;
allow hal_keymint_default tee_service:service_manager find;
allow hal_keymint_default tee_hwservice:hwservice_manager find;

# Basic permissions
allow hal_keymint_default self:process { fork sigchld };
allow hal_keymint_default ashmem_device:chr_file { read write open map };
allow hal_keymint_default binder_device:chr_file { read write ioctl open };

# Service registration
allow hal_keymint_default hal_keymint_default_service:service_manager add;
allow hal_keymint_default hal_keymint_default_hwservice:hwservice_manager add;

# Property access
allow hal_keymint_default hal_keymint_default_prop:property_service set;