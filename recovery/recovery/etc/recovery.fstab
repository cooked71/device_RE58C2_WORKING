#<src>          <mnt_point>     <type>  <mnt_flags>                                 <fs_mgr_flags>
/dev/block/by-name/system       /system         erofs   ro,barrier=1                                wait,slotselect,avb=vbmeta_system
/dev/block/by-name/system_ext   /system_ext     erofs   ro,barrier=1                                wait,slotselect,avb=vbmeta_system_ext
/dev/block/by-name/product      /product        erofs   ro,barrier=1                                wait,slotselect,avb=vbmeta_product
/dev/block/by-name/vendor       /vendor         erofs   ro,barrier=1                                wait,slotselect,avb=vbmeta_vendor
/dev/block/by-name/odm          /odm            erofs   ro,barrier=1                                wait,slotselect,avb=vbmeta_odm
/dev/block/by-name/vendor_dlkm  /vendor_dlkm    erofs   ro,barrier=1                                wait,slotselect,avb=vbmeta_vendor_dlkm
/dev/block/by-name/boot         /boot           emmc    defaults                                    defaults
/dev/block/by-name/vendor_boot  /vendor_boot    emmc    defaults                                    defaults
/dev/block/by-name/userdata     /data           f2fs    nosuid,nodev,noatime,discard               latemount,wait,check,formattable
/dev/block/by-name/metadata     /metadata       emmc    nosuid,nodev,noatime                       wait,formattable
/dev/block/by-name/cache        /cache          ext4    nosuid,nodev,noatime                       wait,check
