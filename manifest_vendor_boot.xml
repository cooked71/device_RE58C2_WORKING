<?xml version="1.0" encoding="utf-8"?>
<manifest version="1.0" type="device">
    <!-- Boot HALs -->
    <hal format="hidl">
        <name>android.hardware.boot</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IBootControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.boot</name>
        <transport>hwbinder</transport>
        <version>1.1</version>
        <interface>
            <name>IBootControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.boot</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>IBootControl</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Health HALs -->
    <hal format="hidl">
        <name>android.hardware.health</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IHealth</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.health</name>
        <transport>hwbinder</transport>
        <version>2.0</version>
        <interface>
            <name>IHealth</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.health</name>
        <transport>hwbinder</transport>
        <version>2.1</version>
        <interface>
            <name>IHealth</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Fastboot HALs -->
    <hal format="hidl">
        <name>android.hardware.fastboot</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IFastboot</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.fastboot</name>
        <transport>hwbinder</transport>
        <version>1.1</version>
        <interface>
            <name>IFastboot</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- VENDOR-SPECIFIC HALs -->
    <hal format="hidl">
        <name>vendor.sprd.hardware.boot</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>IBootControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    
    <hal format="hidl">
        <name>vendor.sprd.hardware.production</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IProduction</name>
            <instance>default</instance>
        </interface>
    </hal>
</manifest>