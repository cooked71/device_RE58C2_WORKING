<resources>
    <!-- Minimum and maximum brightness values -->
    <integer name="config_screenBrightnessSettingMinimum">0</integer>
    <integer name="config_screenBrightnessSettingMaximum">1023</integer>

    <!-- Default brightness (roughly 40% of max for your panel) -->
    <integer name="config_screenBrightnessDefault">400</integer>

    <!-- Optional: a simple brightness curve for auto-brightness -->
    <integer-array name="config_brightnessCurve">
        <!-- format: ambient_lux, brightness_value pairs -->
        <item>0</item>    <item>0</item>
        <item>100</item>  <item>150</item>
        <item>500</item>  <item>400</item>
        <item>1000</item> <item>600</item>
        <item>2000</item> <item>800</item>
        <item>4000</item> <item>1023</item>
    </integer-array>
</resources>
