service vendor.sprd.boot-hal-1-2 /vendor/bin/hw/vendor.sprd.hardware.boot@1.2-service
    class early_hal
    user root
    group root
    # Register both standard and vendor interfaces
    interface android.hardware.boot@1.0 IBootControl default
    interface android.hardware.boot@1.1 IBootControl default
    interface android.hardware.boot@1.2 IBootControl default
    interface vendor.sprd.hardware.boot@1.2 IBootControl default
