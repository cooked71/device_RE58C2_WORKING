#
# Create missing directories for Unisoc RE58C2 boot
#

on early-init
    # =============================================
    # CRITICAL: Credential and Key Store Directories
    # =============================================
    
    # Credential store - failing in boot logs
    mkdir /data/misc/credstore 0770 system system
    chown system system /data/misc/credstore
    chmod 0770 /data/misc/credstore
    
    # Keystore directories  
    mkdir /data/misc/keystore 0770 keystore keystore
    chown keystore keystore /data/misc/keystore
    chmod 0770 /data/misc/keystore
    
    # APEX data directory
    mkdir /data/misc/apexdata 0770 system system
    chown system system /data/misc/apexdata
    chmod 0770 /data/misc/apexdata

    # =============================================
    # SECURITY: KeyMaster and KeyMint Directories
    # =============================================
    
    # KeyMaster data
    mkdir /data/misc/keymaster 0770 system system
    chown system system /data/misc/keymaster
    chmod 0770 /data/misc/keymaster
    
    # KeyMint data
    mkdir /data/misc/keymint 0770 system system
    chown system system /data/misc/keymint
    chmod 0770 /data/misc/keymint

    # =============================================
    # TRUSTY: Secure Element Directories
    # =============================================
    
    # Trusty secure storage
    mkdir /data/misc/trusty 0770 system system
    chown system system /data/misc/trusty
    chmod 0770 /data/misc/trusty
    
    # TEE (Trusted Execution Environment) data
    mkdir /data/misc/tee 0770 system system
    chown system system /data/misc/tee
    chmod 0770 /data/misc/tee

    # =============================================
    # SYSTEM: Additional Critical Directories
    # =============================================
    
    # System properties persistence
    mkdir /data/misc/property 0770 system system
    chown system system /data/misc/property
    chmod 0770 /data/misc/property
    
    # System debug data
    mkdir /data/misc/trace 0770 system system
    chown system system /data/misc/trace
    chmod 0770 /data/misc/trace

    # =============================================
    # VENDOR: Unisoc-specific Directories
    # =============================================
    
    # Unisoc vendor data
    mkdir /data/misc/unisoc 0770 system system
    chown system system /data/misc/unisoc
    chmod 0770 /data/misc/unisoc
    
    # Sprd vendor data
    mkdir /data/misc/sprd 0770 system system
    chown system system /data/misc/sprd
    chmod 0770 /data/misc/sprd

    # =============================================
    # CACHE: Ensure cache directories exist
    # =============================================
    
    # Cache for system services
    mkdir /data/misc/cache 0770 system system
    chown system system /data/misc/cache
    chmod 0770 /data/misc/cache

on post-fs-data
    # =============================================
    # POST FILESYSTEM: Additional directories
    # =============================================
    
    # Ensure all directories have correct SELinux labels
    restorecon_recursive /data/misc/credstore
    restorecon_recursive /data/misc/keystore
    restorecon_recursive /data/misc/apexdata
    restorecon_recursive /data/misc/keymaster
    restorecon_recursive /data/misc/keymint
    restorecon_recursive /data/misc/trusty
    restorecon_recursive /data/misc/tee

# =============================================
# SERVICE-SPECIFIC DIRECTORY CREATION
# =============================================

# For keystore2 service
on property:init.svc.keystore2=running
    # Ensure keystore directories are ready
    mkdir /data/misc/keystore/keys 0770 keystore keystore
    chown keystore keystore /data/misc/keystore/keys
    chmod 0770 /data/misc/keystore/keys

# For credstore service  
on property:init.svc.credstore=running
    # Ensure credstore directories are ready
    mkdir /data/misc/credstore/keys 0770 system system
    chown system system /data/misc/credstore/keys
    chmod 0770 /data/misc/credstore/keys

# =============================================
# BOOT COMPLETION: Final directory setup
# =============================================

on property:sys.boot_completed=1
    # Final permissions check
    chown system system /data/misc/credstore
    chown keystore keystore /data/misc/keystore
    chown system system /data/misc/apexdata
    
    # Final SELinux context restoration
    restorecon_recursive /data/misc